# Copie para .env.local (local) ou cadastre na Vercel: Project → Settings → Environment Variables.
# NUNCA faça commit dos valores reais. Depois de mudar variáveis na Vercel, faça Redeploy.

# Supabase — Dashboard → Project Settings → API (projeto bebjswervqdokkhpggro)
SUPABASE_URL=https://bebjswervqdokkhpggro.supabase.co
# Chave pública (anon / publishable): usada no login por e-mail e senha
SUPABASE_ANON_KEY=
# Chave service_role: só no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys (opcional: sem ela, use "Colar resultado")
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-sonnet-4-6
ANTHROPIC_MODEL=

# Google Places API (New) — projeto com faturamento ativo
GOOGLE_PLACES_API_KEY=
