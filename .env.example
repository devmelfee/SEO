# Copie para .env.local (local) ou cadastre na Vercel: Project → Settings → Environment Variables.
# NUNCA faça commit dos valores reais. Depois de mudar variáveis na Vercel, faça Redeploy.

# Supabase — Dashboard → Project Settings → API (projeto bebjswervqdokkhpggro)
SUPABASE_URL=https://bebjswervqdokkhpggro.supabase.co
# Chave pública (anon / publishable): usada no login por e-mail e senha
SUPABASE_ANON_KEY=
# Chave service_role: só no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys (opcional: sem ela, use "Colar resultado")
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-sonnet-4-6
ANTHROPIC_MODEL=

# Google Places API (New) — projeto com faturamento ativo
GOOGLE_PLACES_API_KEY=

# Perfil da Empresa no Google (opcional: sem isto, a fila funciona no modo assistido — copiar e colar).
# Passo a passo em docs/perfil-google.md. URI de redirecionamento: https://SEU-DOMINIO/api/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave para cifrar o token do Google no banco (qualquer texto longo e aleatório; não troque depois de conectar)
GOOGLE_TOKEN_KEY=
# Opcional: só se o domínio público for diferente do que o app enxerga
GOOGLE_OAUTH_REDIRECT_URI=
# Protege o agendador de posts (/api/cron/gbp). A Vercel envia este valor sozinha nos crons.
CRON_SECRET=
