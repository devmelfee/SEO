# Copie para .env.local (local) ou cadastre na Vercel: Project → Settings → Environment Variables.
# NUNCA faça commit dos valores reais.

# Senha de acesso da equipe. Sem ela, as rotas de API ficam bloqueadas (o app não gasta IA nem lê o banco).
APP_PASSWORD=

# Segredo para assinar o cookie de login (qualquer texto longo e aleatório, ex.: `openssl rand -hex 32`).
SESSION_SECRET=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-sonnet-4-6 (o modelo que o protótipo usava)
ANTHROPIC_MODEL=

# Supabase — Dashboard → Project Settings → API (projeto tyiyxxfuwzfxqwfdowvb)
SUPABASE_URL=https://tyiyxxfuwzfxqwfdowvb.supabase.co
# Chave service_role: só no servidor, nunca no navegador
SUPABASE_SERVICE_ROLE_KEY=

# Google Places API (New) — gere uma chave NOVA (a antiga foi exposta) e restrinja à Places API
GOOGLE_PLACES_API_KEY=
